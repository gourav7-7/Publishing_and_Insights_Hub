# Notion integration: share both Content databases with this integration.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_VERSION=2026-03-11
NOTION_TIMEOUT_SECONDS=20

# Existing PostgreSQL database used for idempotency and workflow run logs.
DATABASE_URL=postgresql://publishing_hub_app:CHANGE_ME@127.0.0.1:5432/publishing_hub

# Buffer test account: Threads and X use separate channel IDs.
# LinkedIn uses Simulation and does not create or query a Buffer post.
BUFFER_API_KEY=your_buffer_api_key
BUFFER_CHANNEL_ID=your_threads_test_channel_id
BUFFER_CHANNEL_ID_X=your_x_test_channel_id
BUFFER_ORGANIZATION_ID=your_buffer_organization_id
BUFFER_TIMEOUT_SECONDS=20
# Supported values: threads, x, linkedin. This is the default when API platform is omitted.
PUBLISHING_PLATFORM=threads

# API caller authentication and safety switch.
PUBLISHING_API_TOKEN=replace_with_a_long_random_token
ENABLE_LIVE_SCHEDULING=false

# Comma-separated Notion user IDs. Use real, authorized Notion users.
NOTION_AUTHORIZED_APPROVER_IDS=notion_user_uuid
NOTION_AUTHORIZED_FOUNDER_APPROVER_IDS=notion_founder_uuid
APPROVAL_SNAPSHOT_SECRET=replace_with_a_random_secret_at_least_32_bytes

# Optional Slack incoming webhook. Leave blank to disable alerts.
SLACK_WEBHOOK_URL=
